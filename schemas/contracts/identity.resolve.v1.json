{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cove.invalid/contracts/identity.resolve.v1.json",
  "title": "identity.resolve v1",
  "description": "Identifiers (E.164 phone, lower-case email, platform handle, or a display name) to refs. confidence is 0..1; method says how it matched (phone, email, handle, name). Only phone/email matches are safe to auto-link.",
  "$defs": {
    "ref": {
      "type": "string",
      "pattern": "^cove:[a-z][a-z0-9_]*/[a-z_]+/[A-Za-z0-9._:-]+$"
    }
  },
  "input": {
    "type": "object",
    "required": [
      "identifiers"
    ],
    "properties": {
      "identifiers": {
        "type": "array",
        "maxItems": 500,
        "items": {
          "type": "string",
          "maxLength": 320
        }
      }
    }
  },
  "output": {
    "type": "array",
    "items": {
      "type": "object",
      "required": [
        "identifier",
        "ref",
        "label",
        "confidence",
        "method"
      ],
      "properties": {
        "identifier": {
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/ref"
        },
        "label": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "method": {
          "enum": [
            "phone",
            "email",
            "handle",
            "name"
          ]
        }
      }
    }
  }
}
