# Non-secret settings. Secrets live in ./secrets/*.txt (see scripts/init-secrets.sh).
COVE_TIMEZONE=Europe/Amsterdam
# Extra hostnames the MCP server accepts (e.g. this machine's tailnet name for tailscale serve)
COVE_MCP_EXTRA_HOSTS=
# MCP addresses shown on the home page (comma-separated; last one is used in the "claude mcp add" snippet)
COVE_MCP_URLS=http://127.0.0.1:8765/mcp
# Sign-in (docs/auth.md): where your browser reaches cove, and Pocket ID (the passkey sign-in service)
COVE_PUBLIC_URL=http://localhost:8080
COVE_AUTH_URL=http://localhost:1411
# Encrypted backups (docs/backups.md): age public key(s), comma-separated. Create with scripts/init-backup-key.sh
COVE_BACKUP_AGE_RECIPIENTS=
# Off-site backups: a restic repository, e.g. s3:https://s3.<region>.backblazeb2.com/<bucket>/cove
# then set COMPOSE_PROFILES=offsite to start the offsite service
COVE_OFFSITE_REPOSITORY=
