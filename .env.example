# Non-secret settings. Secrets live in ./secrets/*.txt (see scripts/init-secrets.sh).
COVE_TIMEZONE=Europe/Amsterdam
# Extra hostnames the MCP server accepts (e.g. this machine's tailnet name for tailscale serve)
COVE_MCP_EXTRA_HOSTS=
# MCP addresses shown on the home page (comma-separated; last one is used in the "claude mcp add" snippet)
COVE_MCP_URLS=http://127.0.0.1:8765/mcp
